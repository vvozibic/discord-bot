# Discord
DISCORD_TOKEN=your_discord_bot_token
VERIFY_CHANNEL=verify
DISCORD_GUILD_ID=1400787114333044887
BELIEVER_CAMPAIGN_CHANNEL_ID=1400787115008331868
BELIEVER_ROLE_ID=1516725109941993532
MEMBER_EXPORT_FETCH_DELAY_SECONDS=0.35
AUDIT_CHANNEL_ID=1527375658014085292
IMAGE_AUDIT_CHANNEL_ID=1400848157436280943
AUDIT_TIMEZONE=Europe/Warsaw
AUDIT_WINNER_COUNT=5
AUDIT_MAX_RANGE_DAYS=31
AUDIT_MAX_MESSAGES=10000
AUDIT_MAX_BUFFER_MB=8

# X (Twitter) OAuth2 — create app at https://developer.x.com/
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=https://your-app.railway.app/x/callback
X_SCOPES=users.read tweet.read

# App-only credential for /pick-x-comments and /redraw-x-comments.
# The X app must have full-archive search access.
X_BEARER_TOKEN=your_x_app_bearer_token
X_RAFFLE_MAX_REPLIES=5000

# Callback server (for OAuth). On Railway leave default.
OAUTH_HOST=0.0.0.0
PORT=8000

# Database:
# - Production: set DATABASE_URL to PostgreSQL URI
# - Local fallback: SQLite file if DATABASE_URL is empty
DATABASE_URL=
DB_FILE=bot_database.db

# Secret for signing !xlink URLs (use a long random string)
LINK_SECRET=your_long_random_secret_change_me
