# Use the SAME application ID and OAuth client secret as the deployed Python bot.
# Keep secrets in Railway variables; never commit a filled env file.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GAME_ALLOWED_GUILD_ID=1400787114333044887
GAME_BETA_ROLE_ID=1564276225520963726
# Optional comma-separated administrator role IDs permitted to play the beta.
GAME_ADMIN_ROLE_IDS=
GAME_EVENT_ID=mindo-beta
GAME_EVENT_NAME=Mindo AI beta
# PostgreSQL: GAME_DATABASE_URL explicitly, or the existing DATABASE_URL
# when no SQLite path/volume is selected. Keep actual connection strings private.
GAME_DATABASE_URL=
# SQLite fallback: derived from the attached volume when left empty.
GAME_DATABASE_PATH=
GAME_BIND_HOST=0.0.0.0
PORT=5179
# Railway volumes are mounted as root; required by this image's node user.
RAILWAY_RUN_UID=0
